# Copy to .env and paste your Beijing API key. Existing environment variables win.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Supported text-to-video models: wan2.6-t2v, wan2.7-t2v,
# wan2.7-t2v-2026-06-12. Do not use an OpenAI-compatible chat endpoint.
BAILIAN_VIDEO_MODEL=wan2.6-t2v
# Optional model for shots with version-pinned image/voice references.
BAILIAN_REFERENCE_VIDEO_MODEL=wan2.7-r2v
BAILIAN_VIDEO_RESOLUTION=720P
BAILIAN_VIDEO_RATIO=9:16
BAILIAN_VIDEO_DURATION=5
BAILIAN_VIDEO_PROMPT_EXTEND=true
BAILIAN_VIDEO_WATERMARK=false
BAILIAN_VIDEO_POLL_INTERVAL=10
BAILIAN_VIDEO_WAIT_TIMEOUT=900
BAILIAN_VIDEO_REQUEST_TIMEOUT=60
BAILIAN_VIDEO_OUTPUT_DIR=outputs/videos

# Story compiler: Qwen text model; reuses DASHSCOPE_API_KEY.
BAILIAN_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_TEXT_MAX_TOKENS=8192
BAILIAN_TEXT_REQUEST_TIMEOUT=180

# Timestamped-frame observation; shares the Beijing API key and text endpoint.
BAILIAN_VISION_MODEL=qwen3-vl-plus
BAILIAN_VISION_MAX_TOKENS=4096
BAILIAN_VISION_REQUEST_TIMEOUT=180
