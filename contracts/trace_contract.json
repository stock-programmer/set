  "manual_integrations": [
    {
      "entry": "tools.workbench_loop_trace_recovery.reconcile_readonly_pause",
      "coverage": "An independent watchdog verifies the original chain in a new linked Trace. It archives an exact watcher pause when SQLite rejected BEGIN for the end of a known read-only dependency inspection, or for a read batch whose durable ERROR identifies only staged catalog reads. Other failures retain the pause.",
      "tests": "tests.test_workbench_trace_pause"
    },
    {
      "entry": "pianchang.sdk_transport._Wire.handle_request",
      "coverage": "Persist the final SDK request after serialization and before transport. Capture the response or error at receipt, link the wire digest to the video job, and prevent a second creation request. Queries and downloads use the original task identity. Record the Windows proxy selection before connecting. An http.error distinguishes a proven connection-stage failure from an unknown submission using the matching httpcore exception and origin write boundary. A proxy CONNECT precedes the origin request. The transport never retries or falls back to direct.",
      "tests": "tests.test_model_gateway.SDKTransportTests; tests.test_sdk_video; tests.test_sdk_proxy"
    },
    {
      "entry": "pi_bridge.runtime.PiLoop.run",
      "coverage": "Calls the registered SDK execution span before lock/tool/model activity and catches failures including span-end persistence errors. Bounded close/terminate/kill and gateway revocation preserve the primary exception. Fail-closed domain checkpoints use SDK redaction and atomic replacement when Trace is unavailable; they do not substitute for Trace or dispatch work.",
      "tests": "tests.test_pi_interruption.InterruptionTests; tests.test_pi_runtime.PiRuntimeTests"
    },
    {
      "entry": "pianchang.web_server.create_server",
      "coverage": "Every dispatched HTTP request, response, rejection and error; trace query responses use explicit summaries to avoid recursive capture. Owns the independent SDK storage-session lifetime. Bootstrap/jobs/project/studio/reference-media GET computations, existing Pi-scope lookups and scoped live-event projections batch read-only trace events. The bootstrap, workspace cache hit, video detail and shot progress GETs commit read evidence with the actual response body and headers before sending any bytes. The workbench HTML and static bundles commit the hash of the served bytes and response headers before sending. SSE headers, actual frames, heartbeats and disconnects use the existing HTTP root, with cursor-based read-only reconnection and no task dispatch. Mutations, provider calls, media serving and Pi session creation remain immediate.",
      "tests": "tests.test_trace_integration.TraceIntegrationTests; tests.test_pi_live.PiLiveTests"
