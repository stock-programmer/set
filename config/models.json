        "seedance-mini": {
            "connection": "ark-production",
            "adapter": "litellm",
            "sdk_provider": "volcengine",
            "model_id": "doubao-seedance-2-0-mini-260615"
        }
    },
    "routes": {
        "script.decision": "openai-writer",
        "video.decision": "openai-writer",
        "story.compile": "openai-writer",
        "reference.prompt": "openai-writer",
        "voice.casting": "openai-writer",
        "video.repair_strategy": "openai-writer",
        "reference.image": "seedream-5-0",
        "voice.synthesis": "openai-voice",
        "voice.review": "openai-listener",
        "vision.review": "openai-vision",
        "continuity.review": "openai-listener",
        "video.text_to_video": "seedance-mini",
        "video.reference_to_video": "seedance-mini"
