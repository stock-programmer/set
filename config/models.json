        "openai-production": {
            "provider": "openai",
            "account": "studio-openai",
            "base_url": "https://api.openai.com/v1",
            "api_key_env": "OPENAI_API_KEY"
        },
        "ark-production": {
            "provider": "volcengine-ark",
            "account": "studio-ark",
            "base_url": "https://ark.cn-beijing.volces.com/api/v3",
            "api_key_env": "ARK_VIDEO_API_KEY"
        }
    },
    "models": {
        "openai-writer": {
            "connection": "openai-production", "adapter": "litellm", "sdk_provider": "openai",
            "model_id": "gpt-5.4"
        },
        "openai-image": {
            "connection": "openai-production", "adapter": "litellm", "sdk_provider": "openai",
            "model_id": "gpt-image-2.5-flare"
        },
        "seedream-5-0": {
            "connection": "ark-production", "adapter": "litellm", "sdk_provider": "openai",
            "model_id": "doubao-seedream-5-0-pro-260628", "image_size": "2048x2048",
            "image_response_format": "b64_json"
        },
        "openai-vision": {
            "connection": "openai-production", "adapter": "openai", "model_id": "gpt-5.4-mini"
        },
        "openai-voice": {
            "connection": "openai-production", "adapter": "litellm", "sdk_provider": "openai",
            "model_id": "gpt-audio-1.5"
        },
        "openai-listener": {
            "connection": "openai-production", "adapter": "openai", "model_id": "gpt-audio-1.5"
